# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OPTION A, simplest: send from a Gmail account (no domain needed).
# Turn on 2-Step Verification on the Gmail account, then create an App Password at
# myaccount.google.com/apppasswords and paste the 16 characters below.
SMTP_USER=
SMTP_PASS=

# OPTION B: Resend (leave SMTP_USER and SMTP_PASS empty to use this).
# The sender must use a domain you verified in Resend.
RESEND_API_KEY=
# EMAIL_FROM is optional with Gmail, required with Resend, e.g. IBIGANZA <hello@yourdomain.org>
EMAIL_FROM=

# Who gets an email for every new message, separated by commas.
# Leave empty to use the list in lib/config.js (notifyEmails).
NOTIFY_EMAIL=
# Replies from people who wrote to you go to this address.
REPLY_TO_EMAIL=

# Admin login. Pick a long password and a long random secret.
ADMIN_PASSWORD=change-this-password
ADMIN_SECRET=change-this-to-a-long-random-string

# Public site address (used for the page metadata), no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
